<UserControl x:Class="SatrancUI.TerfiMenusu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SatrancUI"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border Width="275"
            Height="125"
            Style="{StaticResource BorderStyle}">
        <Grid RenderOptions.BitmapScalingMode="HighQuality">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="1.5*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="TAŞ SEÇİN"
                       Style="{StaticResource TextStyle}"
                       FontSize="28"/>

            <UniformGrid Grid.Row="1"
                         Rows="1"
                         Columns="4"
                         Cursor="Hand">
                <Image x:Name="VezirResmi"
                       MouseDown="VezirResmi_MouseDown"
                       Source="Assets/BeyazVezir.png"/>

                <Image x:Name="FilResmi"
                       MouseDown="FilResmi_MouseDown"
                       Source="Assets/BeyazFil.png"/>

                <Image x:Name="KaleResmi"
                       MouseDown="KaleResmi_MouseDown"
                       Source="Assets/BeyazKale.png"/>

                <Image x:Name="AtResmi"
                       MouseDown="AtResmi_MouseDown"
                       Source="Assets/BeyazAt.png"/>

            </UniformGrid>
        </Grid>

    </Border>

</UserControl>
