<UserControl x:Class="SatrancUI.OyunModuMenusu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Center" VerticalAlignment="Center">

    <UserControl.Resources>
        <Style x:Key="ButonStili" TargetType="Button">
            <Setter Property="Background" Value="#EAEAEA"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="10,15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D4D4D4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#C0C0C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Kutu sadece kendi içeriği kadar büyüyecek -->
    <Border Background="#2B2B2B" CornerRadius="10" Padding="25" Width="380">
        <StackPanel>
            <TextBlock Text="Oyun Modu Seçin" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <!-- Parantez içindeki açıklamalar silindi, daha sade bir görünüm elde edildi -->
            <Button Content="Normal Oyun" Click="NormalOyunButon_Click" Style="{StaticResource ButonStili}" Margin="0,0,0,10"/>
            <Button Content="Yapay Zekaya Karşı" Click="YapayZekaButon_Click" Style="{StaticResource ButonStili}"/>
        </StackPanel>
    </Border>
</UserControl>