<Window x:Class="SatrancUI.AnaMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SatrancUI"
        mc:Ignorable="d"
        Icon="Assets/icon.ico"
        Title="Satranç Ana Menü" 
        Width="800"
        Height="800"
        WindowStartupLocation="CenterScreen">
    <Border Style="{StaticResource BorderStyle}">
        <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="150"/>
                    <RowDefinition Height="75"/>
                    <RowDefinition Height="75"/>
                    <RowDefinition Height="75"/>
                    <RowDefinition Height="75"/>
                    <RowDefinition Height="75"/>
                </Grid.RowDefinitions>

                <TextBlock 
                    Text="Satranç" 
                    FontSize="52" 
                    FontWeight="Bold" 
                    HorizontalAlignment="Center" 
                    Grid.Row="0" 
                    Margin="50" 
                    Style="{StaticResource TextStyle}"/>

                <Button 
                    x:Name="OyunaBaslaButon" 
                    Content="Oyuna Başla" 
                    HorizontalAlignment="Center" 
                    Width="200" 
                    Height="50" 
                    Margin="10" 
                    Grid.Row="1" 
                    FontSize="25" 
                    Style="{StaticResource ButtonStyle}" 
                    Click="OyunaBaslaButon_Click"/>

                <Button 
                    x:Name="TahtaDuzenleButon" 
                    Content="Tahtayı Düzenle" 
                    HorizontalAlignment="Center" 
                    Width="200" 
                    Height="50" 
                    Margin="10" 
                    Grid.Row="2" 
                    FontSize="25" 
                    Style="{StaticResource ButtonStyle}" 
                    Click="TahtaDuzenleButon_Click"/>

                <Button 
                    x:Name="Stockfish" 
                    Content="StockFish'in Konumu" 
                    HorizontalAlignment="Center" 
                    Width="200" 
                    Height="50" 
                    Margin="10" 
                    Grid.Row="3" 
                    FontSize="22" 
                    Style="{StaticResource ButtonStyle}" 
                    Click="Stockfish_Click"/>

                <Button 
                    x:Name="CikisButon" 
                    Content="Çıkış" 
                    HorizontalAlignment="Center" 
                    Width="200" 
                    Height="50" 
                    Margin="10" 
                    Grid.Row="4" 
                    FontSize="25" 
                    Style="{StaticResource ButtonStyle}" 
                    Click="CikisButon_Click"/>

                <Grid Grid.Row="5" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center" 
                    RenderOptions.BitmapScalingMode="HighQuality">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>
                    <UniformGrid Grid.Column="0" Rows="1" Columns="6" Margin="0 0 10 0">
                        <Image Source="Assets/BeyazPiyon.png" />
                        <Image Source="Assets/BeyazAt.png" />
                        <Image Source="Assets/BeyazFil.png"/>
                        <Image Source="Assets/BeyazKale.png" />
                        <Image Source="Assets/BeyazVezir.png" />
                        <Image Source="Assets/BeyazSah.png" />
                    </UniformGrid>
                    <UniformGrid Grid.Column="1">
                        <Image Source="Assets/VS.png"/>
                    </UniformGrid>
                    <UniformGrid Grid.Column="2" Rows="0" Columns="6" Margin="10 0 0 0">
                        <Image Source="Assets/SiyahSah.png" />
                        <Image Source="Assets/SiyahVezir.png"/>
                        <Image Source="Assets/SiyahKale.png"/>
                        <Image Source="Assets/SiyahFil.png" />
                        <Image Source="Assets/SiyahAt.png" />
                        <Image Source="Assets/SiyahPiyon.png" />
                    </UniformGrid>
                </Grid>

                <!-- Container tüm satırları kaplayıp tam merkeze oturacak şekilde ayarlandı -->
                <ContentControl x:Name="MenuContainer"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Grid.Row="0"
                                Grid.RowSpan="6"/>
                <ContentControl x:Name="UyariContainer" 
                Panel.ZIndex="99"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Grid.Row="0"
                Grid.RowSpan="6"/>
</Grid>
        </Viewbox>
    </Border>
</Window>