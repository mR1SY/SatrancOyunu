<UserControl x:Class="SatrancUI.SureSecimMenusu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SatrancUI"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             HorizontalAlignment="Center" VerticalAlignment="Center"
             Focusable="True"
             Loaded="UserControl_Loaded"
             PreviewKeyDown="UserControl_PreviewKeyDown">

    <Border 
        Width="400" 
        Padding="25" 
        Style="{StaticResource BorderStyle}">
        <Grid>
            <!-- Üst Bar: X ve Geri Butonları -->
            <Grid VerticalAlignment="Top" Margin="0,0,0,10">
                <!-- Sol Üst: Çarpı (Kapat) -->
                <Button 
                    Content="✕" 
                    Width="30" Height="30" 
                    HorizontalAlignment="Right" 
                    Background="#E74C3C" Foreground="White" BorderThickness="0" 
                    FontWeight="Bold" Cursor="Hand" 
                    Click="KapatButon_Click"/>
                
                <!-- Sağ Üst: Geri -->
                <Button 
                    Content="↩ Geri" 
                    Width="60" Height="25" 
                    HorizontalAlignment="Left" 
                    Background="#3498DB" 
                    Foreground="White" 
                    BorderThickness="0" 
                    FontWeight="Bold" 
                    Cursor="Hand" 
                    Click="GeriButon_Click"/>
            </Grid>
        
            <StackPanel Margin="0,35,0,0">
            
                <TextBlock 
                    Text="OYUN SÜRESİ SEÇİN" 
                    Style="{StaticResource TextStyle}" 
                    FontSize="18" 
                    HorizontalAlignment="Center" 
                    Margin="0,0,0,15"/>

                <Border Background="#40808080" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                    <!-- Kurşun -->
                        <TextBlock 
                            Text="🚀 Kurşun" 
                            Style="{StaticResource TextStyle}" 
                            Foreground="#F39C12" 
                            FontSize="14" 
                            Margin="5,0,0,5">
                            <TextBlock.Effect>
                                <!-- Dış hat (Stroke) Efekti -->
                                <DropShadowEffect 
                                    Color="Black" 
                                    Direction="0" 
                                    ShadowDepth="0" 
                                    BlurRadius="1" 
                                    Opacity="1"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <UniformGrid Columns="3">
                            <Button 
                                Content="1 dk" 
                                Tag="1,0" 
                                Click="SureSecim_Click" 
                                Style="{StaticResource ButtonStyle}" 
                                Margin="4" 
                                Height="30"/>

                            <Button 
                                Content="1 + 1" 
                                Tag="1,1" 
                                Click="SureSecim_Click" 
                                Style="{StaticResource ButtonStyle}" 
                                Margin="4" 
                                Height="30"/>

                            <Button 
                                Content="2 + 1" 
                                Tag="2,1" 
                                Click="SureSecim_Click" 
                                Style="{StaticResource ButtonStyle}" 
                                Margin="4" 
                                Height="30"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                    <!-- Yıldırım -->
                <Border Background="#40808080" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock 
                            Text="⚡ Yıldırım" 
                            Style="{StaticResource TextStyle}" 
                            Foreground="#F1C40F" 
                            FontSize="14" 
                            Margin="5,0,0,5">
                            <TextBlock.Effect>
                                <!-- Dış hat (Stroke) Efekti -->
                                <DropShadowEffect 
                                Color="Black" 
                                Direction="0" 
                                ShadowDepth="0" 
                                BlurRadius="1" 
                                Opacity="1"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <UniformGrid 
                            Columns="3" 
                            Margin="0,0,0,10">
                        
                        <Button 
                            Content="3 dk" 
                            Tag="3,0" 
                            Click="SureSecim_Click" 
                            Style="{StaticResource ButtonStyle}" 
                            Margin="4" 
                            Height="30"/>

                        <Button 
                            Content="3 + 2" 
                            Tag="3,2" 
                            Click="SureSecim_Click" 
                            Style="{StaticResource ButtonStyle}" 
                            Margin="4" 
                            Height="30"/>

                        <Button 
                            Content="5 dk" 
                            Tag="5,0" 
                            Click="SureSecim_Click" 
                            Style="{StaticResource ButtonStyle}" 
                            Margin="4" 
                            Height="30"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Hızlı -->
                <Border Background="#40808080" CornerRadius="8" Padding="10">
                    <StackPanel>
                        <TextBlock 
                            Text="⏱️ Hızlı" 
                            Style="{StaticResource TextStyle}" 
                            Foreground="#2ECC71" 
                            FontSize="14" 
                            Margin="5,0,0,2">
                            <TextBlock.Effect>
                                <!-- Dış hat (Stroke) Efekti -->
                                <DropShadowEffect Color="Black" Direction="0" ShadowDepth="0" BlurRadius="2" Opacity="1"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <UniformGrid 
                            Columns="3">

                            <Button 
                                Content="10 dk" 
                                Tag="10,0" 
                                Click="SureSecim_Click" 
                                Style="{StaticResource ButtonStyle}" 
                                Margin="4" 
                                Height="30"/>

                            <Button 
                                Content="10 + 5" 
                                Tag="10,5" 
                                Click="SureSecim_Click" 
                                Style="{StaticResource ButtonStyle}" 
                                Margin="4" 
                                Height="30"/>

                            <Button 
                                Content="15 + 10" 
                                Tag="15,10" 
                                Click="SureSecim_Click" 
                                Style="{StaticResource ButtonStyle}" 
                                Margin="4" 
                                Height="30"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>