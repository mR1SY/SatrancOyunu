<UserControl x:Class="SatrancUI.SureSecimMenusu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Center" VerticalAlignment="Center">

    <UserControl.Resources>
        <Style x:Key="SureButonStili" TargetType="Button">
            <Setter Property="Background" Value="#EAEAEA"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="8,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D4D4D4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#C0C0C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#2B2B2B" CornerRadius="10" Padding="25" Width="400">
        <StackPanel>
            <TextBlock Text="Oyun Süresi Seçin" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <!-- Kurşun -->
            <TextBlock Text="🚀 Kurşun" Foreground="#F39C12" FontSize="14" FontWeight="SemiBold" Margin="5,0,0,2"/>
            <UniformGrid Columns="3" Margin="0,0,0,10">
                <Button Content="1 dk" Tag="1,0" Click="SureSecim_Click" Style="{StaticResource SureButonStili}"/>
                <Button Content="1 + 1" Tag="1,1" Click="SureSecim_Click" Style="{StaticResource SureButonStili}"/>
                <Button Content="2 + 1" Tag="2,1" Click="SureSecim_Click" Style="{StaticResource SureButonStili}"/>
            </UniformGrid>

            <!-- Yıldırım -->
            <TextBlock Text="⚡ Yıldırım" Foreground="#F1C40F" FontSize="14" FontWeight="SemiBold" Margin="5,0,0,2"/>
            <UniformGrid Columns="3" Margin="0,0,0,10">
                <Button Content="3 dk" Tag="3,0" Click="SureSecim_Click" Style="{StaticResource SureButonStili}"/>
                <Button Content="3 + 2" Tag="3,2" Click="SureSecim_Click" Style="{StaticResource SureButonStili}"/>
                <Button Content="5 dk" Tag="5,0" Click="SureSecim_Click" Style="{StaticResource SureButonStili}"/>
            </UniformGrid>

            <!-- Hızlı -->
            <TextBlock Text="⏱️ Hızlı" Foreground="#2ECC71" FontSize="14" FontWeight="SemiBold" Margin="5,0,0,2"/>
            <UniformGrid Columns="3">
                <Button Content="10 dk" Tag="10,0" Click="SureSecim_Click" Style="{StaticResource SureButonStili}"/>
                <Button Content="10 + 5" Tag="10,5" Click="SureSecim_Click" Style="{StaticResource SureButonStili}"/>
                <Button Content="15 + 10" Tag="15,10" Click="SureSecim_Click" Style="{StaticResource SureButonStili}"/>
            </UniformGrid>

        </StackPanel>
    </Border>
</UserControl>